:"https://github.com/OISF/suricata-update","keywords":"","license":"GPLv2","license_expression":null,"license_files":null,"maintainer":"","maintainer_email":"","name":"suricata-update","package_url":"https://pypi.org/project/suricata-update/","platform":"","project_url":"https://pypi.org/project/suricata-update/","project_urls":{"Homepage":"https://github.com/OISF/suricata-update"},"provides_extra":null,"release_url":"https://pypi.org/project/suricata-update/1.0.0a1/","requires_dist":null,"requires_python":"","summary":"Suricata Update Tool","version":"1.0.0a1","yanked":false,"yanked_reason":null},"last_serial":25991509,"urls":[{"comment_text":"","digests":{"blake2b_256":"c384f44fcf7c381396b12cfe99aac76a1c4da6f3d4d7bf82c07cc6f4a4696a4e","md5":"ca1abf81fd621ec029fae87ce0bb16f4","sha256":"281b34ecfb2eff8a8a0414483462f90df1100b6787d828f979a23c8729df1837"},"downloads":-1,"filename":"suricata-update-1.0.0a1.tar.gz","has_sig":false,"md5_digest":"ca1abf81fd621ec029fae87ce0bb16f4","packagetype":"sdist","python_version":"source","requires_python":null,"size":55246,"upload_time":"2017-12-05T17:16:19","upload_time_iso_8601":"2017-12-05T17:16:19.109640Z","url":"https://files.pythonhosted.org/packages/c3/84/f44fcf7c381396b12cfe99aac76a1c4da6f3d4d7bf82c07cc6f4a4696a4e/suricata-update-1.0.0a1.tar.gz","yanked":false,"yanked_reason":null}],"vulnerabilities":[{"aliases":["CVE-2018-1000167"],"details":"OISF suricata-update version 1.0.0a1 contains an Insecure Deserialization vulnerability in the insecure yaml.load-Function as used in the following files: config.py:136, config.py:142, sources.py:99 and sources.py:131. The \"list-sources\"-command is affected by this bug. that can result in Remote Code Execution(even as root if suricata-update is called by root). This attack appears to be exploitable via a specially crafted yaml-file at https://www.openinfosecfoundation.org/rules/index.yaml. This vulnerability appears to have been fixed in 1.0.0b1.","fixed_in":["1.0.0b1"],"id":"PYSEC-2018-75","link":"https://osv.dev/vulnerability/PYSEC-2018-75","source":"osv","summary":null,"withdrawn":null},{"aliases":["CVE-2018-1000167"],"details":"Suricata-Update uses the insecure `yaml.load()` function. Code will be executed if the yaml-file contains lines like:\n\n```yaml\nhello: !!python/object/apply:os.system ['ls -l > /tmp/output']\n```\n\nThe vulnerable function can be triggered by \"suricata-update list-sources\". The locally stored index.yaml will be loaded in this function and the malicious code gets executed.","fixed_in":["1.0.0b1"],"id":"GHSA-7c4h-w765-6pwg","link":"https://osv.dev/vulnerability/GHSA-7c4h-w765-6pwg","source":"osv","summary":null,"withdrawn":null}]},"1.0.0b1":{"info":{"author":"Jason Ish","author_email":"ish@unx.ca","bugtrack_url":null,"classifiers":["License :: OSI Approved :: GNU General Public License v2 (GPLv2)"],"description_content_type":null,"docs_url":null,"download_url":"","downloads":{"last_day":-1,"last_month":-1,"last_week":-1},"dynamic":null,"home_page":"https://github.com/OISF/suricata-update","keywords":"","license":"GPLv2","license_expression":null,"license_files":null,"maintainer":"","maintainer_email":"","name":"suricata-update","package_url":"https://pypi.org/project/suricata-update/","platform":"","project_url":"https://pypi.org/project/suricata-update/","project_urls":{"Homepage":"https://github.com/OISF/suricata-update"},"provides_extra":null,"release_url":"https://pypi.org/project/suricata-update/1.0.0b1/","requires_dist":null,"requires_python":"","summary":"Suricata Update Tool","version":"1.0.0b1","yanked":false,"yanked_reason":null},"last_serial":25991509,"urls":[{"comment_text":"","digests":{"blake2b_256":"7ecb3602b2f81856e5541dd07d129ffe4b3275a1934f8e48f4ec1c98f2ea9f5f","md5":"f1056c7a47dcb58fc1122ab020217d14","sha256":"0a2a5d4e045e01335c8499aff0461fbeb0aed65bf5e30ebc245c3985cba38b8e"},"downloads":-1,"filename":"suricata-update-1.0.0b1.tar.gz","has_sig":false,"md5_digest":"f1056c7a47dcb58fc1122ab020217d14",